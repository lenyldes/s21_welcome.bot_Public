# Fictional examples only. Replace all values before running the bot.
# Telegram Bot Configuration
BOT_TOKEN=1234567890:EXAMPLE_BOT_TOKEN_DO_NOT_USE

# Target Telegram Chat / Community ID (negative integer for supergroups)
CHAT_ID=-1001234567890

# Comma-separated Administrator Telegram User IDs
ADMINS_USER_ID=111111111,222222222

# Administrator Contact Telegram Username
MY_TG=@example_admin

# School 21 Rocket.Chat Configuration
# Generate Personal Access Token in Rocket.Chat: My Account -> Personal Access Tokens
ROCKET_TOKEN=your_rocketchat_personal_access_token
ROCKET_ID=your_rocketchat_user_id
ROCKETCHAT_URL=https://chat.example.com

# Paths (Optional overrides, defaults to project root directories)
# DATA_DIR=data
# LOGS_DIR=logs
# ASSETS_DIR=assets
